---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: string; // '' | 'grammatik' | 'wortschatz' | 'schreibschule' | 'rechtschreibung' | 'suche'
}

const {
  title,
  description = 'Französisch lernen: Grammatik, Wortschatz, Schreibschule und Rechtschreibung – übersichtlich erklärt, mit Beispielen und deutschen Übersetzungen.',
  active = ''
} = Astro.props;

const pageTitle = title || 'Französisch lernen – Grammatik, Wortschatz, Schreibschule';

const nav = [
  { key: '', href: '/', label: 'Start' },
  { key: 'grammatik', href: '/grammatik/', label: 'Grammatik' },
  { key: 'wortschatz', href: '/wortschatz/', label: 'Wortschatz' },
  { key: 'schreibschule', href: '/schreibschule/', label: 'Schreibschule' },
  { key: 'rechtschreibung', href: '/rechtschreibung/', label: 'Rechtschreibung' },
  { key: 'suche', href: '/suche/', label: 'Suche' }
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
      <nav class="site-nav" aria-label="Hauptnavigation">
        <a class="brand" href="/">Französisch lernen</a>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={active === item.key ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Viel Erfolg beim Französisch lernen – und ganz viel Spaß dabei!</p>
    </footer>
  </body>
</html>
